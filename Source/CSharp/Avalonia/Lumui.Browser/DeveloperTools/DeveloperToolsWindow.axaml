<Window
    x:Class="Lumui.Browser.DeveloperTools.DeveloperToolsWindow"
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Developer tools | LUMUI Browser"
    Icon="/Assets/lumui-brand.ico"
    Width="1180"
    Height="760"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterOwner">
  <ContentControl x:Name="ToolsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
</Window>
