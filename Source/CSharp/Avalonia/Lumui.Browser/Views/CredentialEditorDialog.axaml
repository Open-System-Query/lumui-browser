<Window
    x:Class="Lumui.Browser.Views.CredentialEditorDialog"
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Icon="/Assets/lumui-brand.ico"
    Width="560"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="26,22" Classes="dialog-header">
      <StackPanel Spacing="3">
        <TextBlock x:Name="DialogTitleText" FontSize="32" FontWeight="Light" />
        <TextBlock x:Name="DialogDescriptionText" Classes="subtle" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Margin="26" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Website" />
        <TextBox x:Name="OriginBox" Margin="0,6,0,0" MinHeight="42" PlaceholderText="https://example.com" AutomationProperties.Name="Website" />
      </StackPanel>
      <StackPanel Grid.Row="1">
        <TextBlock FontWeight="SemiBold" Text="Username" />
        <TextBox x:Name="UserNameBox" Margin="0,6,0,0" MinHeight="42" AutomationProperties.Name="Username" />
      </StackPanel>
      <StackPanel Grid.Row="2" Spacing="6">
        <TextBlock FontWeight="SemiBold" Text="Password" />
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox x:Name="PasswordBox" MinHeight="42" PasswordChar="●" AutomationProperties.Name="Password" />
          <Button x:Name="ShowButton" Grid.Column="1" MinHeight="42" Content="Show" />
          <Button x:Name="GenerateButton" Grid.Column="2" MinHeight="42" Content="Generate" />
        </Grid>
      </StackPanel>
      <TextBlock x:Name="StatusText" Grid.Row="3" Classes="error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button x:Name="CancelButton" MinWidth="96" Content="Cancel" />
        <Button x:Name="SaveButton" MinWidth="112" Classes="primary-action" Content="Save" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
