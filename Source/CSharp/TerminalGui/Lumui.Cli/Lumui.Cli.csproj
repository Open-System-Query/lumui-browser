<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>lumui-browser-terminal</AssemblyName>
    <RootNamespace>Lumui.Cli</RootNamespace>
    <AssemblyTitle>LUMUI Browser for Terminal.Gui</AssemblyTitle>
    <Product>LUMUI Browser</Product>
    <Description>Terminal.Gui reference browser for LUMUI.</Description>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platforms>AnyCPU;x64</Platforms>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
    <PackageReference Include="Soenneker.Libraries.FFmpeg" Version="4.0.1085" IncludeAssets="contentFiles" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Lumui.Client\Lumui.Client.csproj" />
  </ItemGroup>

  <Target Name="ValidateBundledMediaDecoder" AfterTargets="Build">
    <Error Condition="'$(DesignTimeBuild)' != 'true' and !Exists('$(TargetDir)Resources\ffmpeg.exe')" Text="The bundled LUMUI browser media decoder was not copied to the output directory." />
  </Target>
</Project>
