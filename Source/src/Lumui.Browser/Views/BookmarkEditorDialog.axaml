<Window
    x:Class="Lumui.Browser.Views.BookmarkEditorDialog"
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Icon="/Assets/lumui-brand.ico"
    Width="540"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="26,22" Classes="dialog-header">
      <StackPanel Spacing="3">
        <TextBlock x:Name="DialogTitleText" FontSize="32" FontWeight="Light" />
        <TextBlock x:Name="DialogDescriptionText" Classes="subtle" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Margin="26" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Name" />
        <TextBox x:Name="TitleBox" Margin="0,6,0,0" MinHeight="42" AutomationProperties.Name="Bookmark name" />
      </StackPanel>
      <StackPanel Grid.Row="1">
        <TextBlock FontWeight="SemiBold" Text="Address" />
        <TextBox x:Name="AddressBox" Margin="0,6,0,0" MinHeight="42" PlaceholderText="https://example.com" AutomationProperties.Name="Address" />
      </StackPanel>
      <StackPanel Grid.Row="2">
        <TextBlock FontWeight="SemiBold" Text="Folder" />
        <TextBox x:Name="FolderBox" Margin="0,6,0,0" MinHeight="42" PlaceholderText="Bookmarks" AutomationProperties.Name="Folder" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Grid.Row="3" Classes="error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button x:Name="CancelButton" MinWidth="96" Content="Cancel" />
        <Button x:Name="SaveButton" MinWidth="112" Classes="primary-action" Content="Save" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
