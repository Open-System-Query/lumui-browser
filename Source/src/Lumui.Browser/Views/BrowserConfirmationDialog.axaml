<Window
    x:Class="Lumui.Browser.Views.BrowserConfirmationDialog"
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Icon="/Assets/lumui-brand.ico"
    Width="460"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto" RowSpacing="24">
    <TextBlock x:Name="MessageText" FontSize="16" TextWrapping="Wrap" MaxWidth="400" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="CancelButton" MinWidth="96" Content="Cancel" />
      <Button x:Name="ConfirmButton" MinWidth="112" Classes="primary-action" />
    </StackPanel>
  </Grid>
</Window>
