<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>lumi</AssemblyName>
    <RootNamespace>Lumui.Launcher</RootNamespace>
    <AssemblyTitle>Lumi</AssemblyTitle>
    <Product>Lumi</Product>
    <Description>The unified desktop and terminal launcher for Lumi.</Description>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationManifest>..\Lumui.Browser\app.manifest</ApplicationManifest>
    <LumuiBrandIcon>$(MSBuildProjectDirectory)\..\..\LUMUI_icon.ico</LumuiBrandIcon>
    <ApplicationIcon>$(LumuiBrandIcon)</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Soenneker.Libraries.FFmpeg" Version="4.0.1085" IncludeAssets="contentFiles" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumui.Browser\Lumui.Browser.csproj" />
    <ProjectReference Include="..\Lumui.Cli\Lumui.Cli.csproj" />
  </ItemGroup>

  <Target Name="RestoreLumuiBrandIcon" BeforeTargets="ValidateLumuiBrandIcon" Condition="!Exists('$(LumuiBrandIcon)')">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\Restore-BrandAssets.ps1&quot;" />
  </Target>

  <Target Name="ValidateLumuiBrandIcon" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(LumuiBrandIcon)')" Text="The canonical LUMUI icon was not found at '$(LumuiBrandIcon)'." />
  </Target>

  <Target Name="ValidateBundledMediaDecoder" AfterTargets="Build">
    <Error Condition="'$(DesignTimeBuild)' != 'true' and !Exists('$(TargetDir)Resources\ffmpeg.exe')" Text="The bundled Lumi media decoder was not copied to the output directory." />
  </Target>
</Project>
